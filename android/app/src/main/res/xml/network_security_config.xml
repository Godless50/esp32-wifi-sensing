<?xml version="1.0" encoding="utf-8"?>
<!-- Только HTTPS. Сертификату сервера приложение доверяет через сопряжение (Server.kt: CA, сверенный с QR-кодом),
     а не через этот файл: в APK нет ничьего сертификата, один APK подходит любому серверу. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
