<?xml version="1.0" encoding="utf-8"?>
<!-- Доверяем локальному CA Caddy (вшит при сборке) и системным CA. Пользовательские CA не нужны. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="@raw/wsn_ca" />
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
